DATABASE_URL=postgresql+psycopg://codeevidence:codeevidence@localhost:5433/codeevidence
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_TOKEN=ghp_your_token_here
# Optional: defaults to codeevidence_test on port 5433
# TEST_DATABASE_URL=postgresql+psycopg://codeevidence:codeevidence@localhost:5433/codeevidence_test
# Optional: defaults to database 15 of the compose Redis
# TEST_REDIS_URL=redis://localhost:6380/15
# Optional
# LOG_LEVEL=INFO
# RATE_LIMIT_CAPACITY=60
# RATE_LIMIT_PER_SECOND=10

# AI review (Anthropic Claude). Set a spending limit in the Anthropic console too.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=fake                  # canned answers, no API calls
# Free local model with Ollama instead of Claude (see doc/review.md):
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=qwen2.5-coder:7b
# LLM_INPUT_USD_PER_MTOK=0
# LLM_OUTPUT_USD_PER_MTOK=0
# REVIEW_TOKEN_BUDGET=6000
# REVIEW_BUDGET_USD=0.25             # per review
# REVIEW_ON_SYNC=false               # review every synced PR automatically
# Post reviews to GitHub only for these repositories (your sandbox), comma-separated
# PUBLISH_REPOSITORIES=your-name/codeevidence-sandbox
# Embeddings: local (open-source model, needs pip install -e ".[embeddings]") or fake
# EMBEDDING_PROVIDER=local
# Chat ("Ask CodeEvidence" in the dashboard, @codeevidence on GitHub)
# CHAT_BUDGET_USD=0.10               # per answer
# CHAT_TOKEN_BUDGET=8000             # evidence sent with a question
# Static analysis on changed files (ruff, semgrep, gitleaks; installed in the Docker image)
# TOOLS_ENABLED=true
# TOOL_TIMEOUT_SECONDS=60
# Links back to the dashboard in GitHub comments and commit statuses
# DASHBOARD_URL=http://localhost:5173
# Dashboard origin allowed by CORS
# CORS_ORIGINS=http://localhost:5173
